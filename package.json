{
  "name": "@irs-public/aloud",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IRS-Public/aloud.git"
  },
  "license": "CC0-1.0",
  "author": "Justin Adelman",
  "contributors": [
    "Sahil Lavingia"
  ],
  "description": "508 mobile screen-reader audit: drive TalkBack and VoiceOver across an app's screens, capture what they speak, and emit evidence transcripts plus a draft OpenACR.",
  "type": "module",
  "bin": {
    "aloud": "bin/aloud.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./acr": "./src/acr/index.mjs",
    "./findings.schema.json": "./src/acr/findings.schema.json",
    "./rules": "./src/rules/catalog.mjs",
    "./web/nvda": "./src/web/nvda.mjs",
    "./web/voiceover": "./src/web/voiceover.mjs",
    "./web/dependencies": "./src/web/dependencies.mjs",
    "./src/*": "./src/*",
    "./bin/*": "./bin/*",
    "./examples/*.json": "./examples/*.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "src/",
    "src/acr/findings.schema.json",
    "examples/*.json",
    "action.yml",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:web": "node --test test/web-smoke.mjs",
    "test:web:nvda": "node test/web-nvda-smoke.mjs",
    "test:web:voiceover": "node test/web-voiceover-smoke.mjs",
    "test:web:external": "node test/real-app/web.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@openacr/openacr": "^0.3.8",
    "js-yaml": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@guidepup/guidepup": "0.34.0",
    "playwright": "1.63.0"
  },
  "peerDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@guidepup/guidepup": "0.34.0",
    "playwright": "1.63.0"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": { "optional": true },
    "@guidepup/guidepup": { "optional": true },
    "playwright": { "optional": true }
  }
}
