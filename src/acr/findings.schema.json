{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/IRS-Public/aloud/blob/main/src/acr/findings.schema.json",
  "title": "aloud findings",
  "description": "Section 508 evidence, one finding per criterion and component, that src/acr/build.mjs turns into a draft OpenACR. This schema checks the shape; src/acr/findings.mjs also checks every criterion and component against the chosen OpenACR catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "components", "findings"],
  "properties": {
    "schemaVersion": {
      "description": "Version of this findings contract. Optional; only 1 exists.",
      "const": 1
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "version": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" }
      }
    },
    "author": { "$ref": "#/definitions/contact" },
    "vendor": { "$ref": "#/definitions/contact" },
    "provenance": {
      "description": "Where the evidence came from. Stated in the report notes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": { "$ref": "#/definitions/text" },
        "workingTreeDirty": {
          "description": "True when the commit had uncommitted changes as the evidence was produced; null when the producer could not tell.",
          "type": ["boolean", "null"]
        },
        "runUrl": { "$ref": "#/definitions/url" },
        "date": { "$ref": "#/definitions/date" },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/definitions/text" },
              "version": { "$ref": "#/definitions/text" },
              "url": { "$ref": "#/definitions/url" }
            }
          }
        }
      }
    },
    "catalog": {
      "description": "a catalog file name from @openacr/openacr/catalog, such as 2.5-edition-wcag-2.2-508-en (the default)",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "components": {
      "description": "The catalog components this product has, such as web or software.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/text" }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/finding" }
    },
    "notes": {
      "description": "Report-level notes: what the evidence as a whole covers, such as screen counts or test environments. Stated in the report notes.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/text" }
    },
    "evaluationMethods": {
      "description": "How the evidence was produced, in plain words. Opens the report's evaluation methods; the level policy sentence follows it.",
      "$ref": "#/definitions/text"
    }
  },
  "definitions": {
    "text": {
      "description": "a non-blank string",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "url": {
      "description": "an absolute http(s) URL",
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "date": {
      "description": "a date as YYYY-MM-DD",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "email": {
          "description": "an email address",
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+$"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "status"],
      "properties": {
        "criterion": {
          "description": "Criterion id exactly as the catalog names it, such as 2.1.1 or 502.2.1.",
          "$ref": "#/definitions/text"
        },
        "component": {
          "description": "One of the declared components. Omit it (or use none) for criteria whose only catalog component is none, such as the Section 508 chapters.",
          "$ref": "#/definitions/text"
        },
        "status": {
          "enum": [
            "met",
            "human-reviewed",
            "standard-interpretation",
            "failing",
            "known-defect",
            "partly-tested",
            "platform-limitation",
            "incomplete",
            "untested",
            "unreviewed",
            "not-triggered",
            "page-level"
          ]
        },
        "covers": {
          "description": "What the evidence checks, in plain words. Never more than it proves.",
          "$ref": "#/definitions/text"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/definitions/text" },
              "url": { "$ref": "#/definitions/url" },
              "environments": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/definitions/text" }
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "summary"],
            "properties": {
              "id": { "$ref": "#/definitions/text" },
              "summary": { "$ref": "#/definitions/text" },
              "kind": { "$ref": "#/definitions/text" },
              "url": { "$ref": "#/definitions/url" }
            }
          }
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/text" }
        },
        "failingShare": {
          "description": "How much of the functionality a failing or known-defect finding affects.",
          "enum": ["some", "all"]
        }
      }
    }
  }
}
