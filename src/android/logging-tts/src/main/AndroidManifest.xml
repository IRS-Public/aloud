<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:label="Aloud recording TTS (silent)" android:allowBackup="false">
    <service android:name=".RecordingTtsService" android:exported="true" android:directBootAware="true">
      <intent-filter><action android:name="android.intent.action.TTS_SERVICE"/></intent-filter>
      <meta-data android:name="android.speech.tts" android:resource="@xml/tts_engine"/>
    </service>
    <activity android:name=".VoiceDataActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay">
      <intent-filter><action android:name="android.speech.tts.engine.CHECK_TTS_DATA"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
    </activity>
  </application>
</manifest>
